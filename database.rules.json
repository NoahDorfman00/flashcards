{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".indexOn": ["stripeCustomerId"],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "flashcardSets": {
          ".write": "auth != null && auth.uid === $uid",
          "$setId": {
            ".validate": "newData.hasChildren(['title', 'topic', 'flashcards', 'userId', 'createdAt']) && newData.child('userId').val() === $uid"
          }
        },
        "subscriptionStatus": {
          ".write": false
        },
        "stripeCustomerId": {
          ".write": false
        },
        "freeGenerationUsed": {
          ".write": false
        },
        "anthropicKeyEncrypted": {
          ".write": false
        },
        "anthropicKeyHint": {
          ".write": false
        }
      }
    }
  }
}
